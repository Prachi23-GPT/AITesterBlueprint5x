{
  "name": "salesforce-playwright-framework",
  "version": "1.0.0",
  "description": "Playwright + TypeScript framework for Salesforce login",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed --project=chromium",
    "test:chromium": "playwright test --project=chromium",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^3.15.0",
    "dotenv": "^18.0.10",
    "typescript": "^7.0.2"
  }
}
